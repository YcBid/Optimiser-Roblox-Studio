local function updateGraph()
	for i = 1, GRAPH_N do
		local v = history[#history - GRAPH_N + i]
		local bar = bars[i]
		if v then
			bar.Size = UDim2.new(1 / GRAPH_N, -1, math.clamp(v / GRAPH_MAX, 0.02, 1), 0)
			bar.BackgroundColor3 = fpsColor(v)
		else
			bar.Size = UDim2.new(1 / GRAPH_N, -1, 0, 0)
		end
	end
end

local function updateSystemStats()
	if #history == 0 then return end
	local sum, mn, mx = 0, math.huge, 0
	for _, v in ipairs(history) do
		sum += v
		mn = math.min(mn, v)
		mx = math.max(mx, v)
	end
	local avg = sum / #history
	local sorted = table.clone(history)
	table.sort(sorted)
	local take = math.max(1, math.ceil(#sorted * 0.01))
	local lowSum = 0
	for i = 1, take do lowSum += sorted[i] end
	local low = lowSum / take

	SY.avg.Text = string.format("%.0f", avg)
	SY.avg.TextColor3 = fpsColor(avg)
	SY.low.Text = string.format("%.0f", low)
	SY.low.TextColor3 = fpsColor(low)
	SY.min.Text = string.format("%.0f", mn)
	SY.max.Text = string.format("%.0f", mx)
	SY.frame.Text = string.format("%.1f ms", 1000 / math.max(avg, 1))

	local okP, ping = pcall(function() return localPlayer:GetNetworkPing() * 1000 end)
	SY.ping.Text = if okP then string.format("%.0f ms", ping) else "n/a"
	if okP then SY.ping.TextColor3 = if ping < 100 then C.Good elseif ping < 200 then C.Warn else C.Bad end

	local ok, v = pcall(function() return StatsService:GetTotalMemoryUsageMb() end)
	SY.mem.Text = if ok then string.format("%.0f MB", v) else "n/a"
	ok, v = pcall(function() return StatsService.InstanceCount end)
	SY.inst.Text = if ok then tostring(v) else "n/a"
	ok, v = pcall(function() return StatsService.PhysicsStepTimeMs end)
	SY.phys.Text = if ok then string.format("%.1f ms", v) else "n/a"
	ok, v = pcall(function() return StatsService.PrimitivesCount end)
	SY.prim.Text = if ok then tostring(v) else "n/a"
	ok, v = pcall(function() return StatsService.MovingPrimitivesCount end)
	SY.moving.Text = if ok then tostring(v) else "n/a"
	ok, v = pcall(function() return settings().Rendering.QualityLevel.Value end)
	SY.qual.Text = if ok then tostring(v) else "Auto"

	local text
	if avg >= 55 and low >= 45 then
		text = "Performances excellentes et stables."
	elseif low < avg * 0.6 then
		text = "Micro-saccades détectées (le 1% bas est très inférieur à la moyenne). Cherchez des pics : scripts lourds, chargement de modèles, particules."
	elseif avg < 30 then
		text = "FPS bas. Utilisez l'onglet Top pour trouver les modèles les plus lourds, puis testez leur impact."
	else
		text = "Performances correctes. Optimisez les modèles « MOYEN » pour gagner en marge."
	end
	adviceLabel.Text = text
end

