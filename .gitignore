-- ===================== LAYOUT / ECHELLE / COMPACT =====================
local function viewport()
	local cam = Workspace.CurrentCamera
	return if cam then cam.ViewportSize else Vector2.new(1280, 720)
end

layoutPanel = function()
	local s = uiScale.Scale
	local vp = viewport()
	local top = root.AbsolutePosition.Y
	local below = vp.Y - (top + BAR_H * s) - 16
	local above = top - 16
	local goBelow = below >= math.min(PANEL_H * s, above)
	local space = if goBelow then below else above
	local h = math.clamp(space / s - 8, 320, PANEL_H)
	panel.Size = UDim2.fromOffset(PANEL_W, h)
	if goBelow then
		panel.AnchorPoint = Vector2.new(1, 0)
		panel.Position = UDim2.new(1, 0, 0, BAR_H + 8)
	else
		panel.AnchorPoint = Vector2.new(1, 1)
		panel.Position = UDim2.new(1, 0, 0, -8)
	end
end

applyScale = function()
	local vp = viewport()
	local s = math.clamp(vp.Y / 900, 0.8, 1.35) * S.uiMul
	if UIS.TouchEnabled and not UIS.KeyboardEnabled then s *= 1.1 end
	s = math.max(0.5, math.min(s, (vp.X - 24) / PANEL_W))
	uiScale.Scale = s
	layoutPanel()
end

applyCompact = function()
	fpsBar.Size = UDim2.fromOffset(if S.compact then 270 else BAR_W, BAR_H)
	msLabel.Visible = not S.compact
	spark.Visible = not S.compact
end

local function setRootTopRight(x, y)
	local vp = viewport()
	local w = root.AbsoluteSize.X
	x = math.clamp(x, w + 4, vp.X - 4)
	y = math.clamp(y, 4, math.max(4, vp.Y - BAR_H * uiScale.Scale - 4))
	root.Position = UDim2.fromOffset(x, y)
	layoutPanel()
end

-- ===================== TABS / PANEL =====================
setTab = function(id)
	currentTab = id
	for tid, page in pairs(pages) do page.Visible = tid == id end
	for _, d in ipairs(TAB_DEFS) do
		if d.id == id then
			headerTitle.Text = d.title
			headerSub.Text = d.sub
		end
	end
	refreshTabs()
	if id == "system" then
		updateGraph()
		updateSystemStats()
	elseif id == "live" then
		updateLive()
	end
end

refreshOpti = function()
	optiBtn.BackgroundColor3 = if isPanelOpen then C.Accent else C.AccentBg
	optiBtn.TextColor3 = if isPanelOpen then C.Bg else C.Accent
	optiStroke.Color = C.Accent
end
bindAccent(refreshOpti)

togglePanel = function(open)
	local target = if open ~= nil then open else not isPanelOpen
	isPanelOpen = target
	if target then
		panel.Visible = true
		layoutPanel()
		if not selected then setPicking(true) end
	else
		panel.Visible = false
		setPicking(false)
		clearMarkers()
		if not testing then
			restoreHidden()
			updateActions()
		end
	end
	refreshOpti()
end

-- ===================== EVENEMENTS UI =====================
hoverFx(optiBtn, function() return if isPanelOpen then C.Accent else C.AccentBg end,
function() return C.Accent:Lerp(C.Bg, if isPanelOpen then 0.1 else 0.55) end)
optiBtn.MouseButton1Click:Connect(function() togglePanel() end)
closeBtn.MouseButton1Click:Connect(function() togglePanel(false) end)

B.pick.MouseButton1Click:Connect(function()
	if testing then return end
	setPicking(not isPicking)
end)
B.up.MouseButton1Click:Connect(function() stepLevel(1) end)
B.down.MouseButton1Click:Connect(function() stepLevel(-1) end)
B.world.MouseButton1Click:Connect(function()
	if testing then return end
	setPicking(false)
	selChain = nil
	updateNavButtons()
	analyze(Workspace)
end)

B.test.MouseButton1Click:Connect(runImpactTest)
B.hide.MouseButton1Click:Connect(function()
	if testing then return end
	if not selected or selected == Workspace then
		toast("Sélectionnez d'abord un modèle précis.", C.Warn)
		return
	end
	if hiddenState then restoreHidden() else applyHidden(selected) end
	updateActions()
end)
B.report.MouseButton1Click:Connect(function()
	if not lastScan then
		toast("Analysez d'abord un modèle.", C.Warn)
		return
	end
	local text = buildReport()
	X.reportBox.Text = text
	X.reportCard.Visible = not X.reportCard.Visible
	if X.reportCard.Visible then print(text) end
end)
B.redo.MouseButton1Click:Connect(function()
	if testing then return end
	if selected then analyze(selected) else toast("Rien à ré-analyser.", C.Warn) end
end)

R.scan.MouseButton1Click:Connect(runRankScan)
R.search:GetPropertyChangedSignal("Text"):Connect(renderRanking)
R.sortScore.MouseButton1Click:Connect(function() rankSort = "score"; refreshRankSort(); renderRanking() end)
R.sortParts.MouseButton1Click:Connect(function() rankSort = "parts"; refreshRankSort(); renderRanking() end)

-- ===================== DRAG =====================
local dragging, dragInput = false, nil
local dragStart, startTR = Vector2.zero, Vector2.zero

local function beginDrag(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragInput = input
		dragStart = Vector2.new(input.Position.X, input.Position.Y)
		startTR = Vector2.new(root.AbsolutePosition.X + root.AbsoluteSize.X, root.AbsolutePosition.Y)
	end
end
fpsBar.InputBegan:Connect(beginDrag)
header.InputBegan:Connect(beginDrag)

G(UIS.InputChanged, function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input == dragInput) then
		local delta = Vector2.new(input.Position.X, input.Position.Y) - dragStart
		setRootTopRight(startTR.X + delta.X, startTR.Y + delta.Y)
	end
end)
G(UIS.InputEnded, function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = false
		dragInput = nil
	end
end)

-- ===================== ENTREES CLAVIER / PICK =====================
G(UIS.InputBegan, function(input, gameProcessed)
	if UIS:GetFocusedTextBox() then return end
	if input.KeyCode == Enum.KeyCode.F6 then
		togglePanel()
		return
	elseif input.KeyCode == Enum.KeyCode.F8 then
		toggleRecord()
		return
	end
	if gameProcessed then return end

	if isPanelOpen then
		if input.KeyCode == Enum.KeyCode.Q then
			stepLevel(1)
			return
		elseif input.KeyCode == Enum.KeyCode.E then
			stepLevel(-1)
			return
		elseif input.KeyCode == Enum.KeyCode.F7 then
			if selected and not testing then analyze(selected) end
			return
		end
	end

	if isPicking and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
		local abs
		if input.UserInputType == Enum.UserInputType.Touch then
			abs = Vector2.new(input.Position.X, input.Position.Y) + GuiService:GetGuiInset()
		else
			abs = UIS:GetMouseLocation()
		end
		if not pointerOverUi(abs) then pickAt(abs) end
	end
end)

-- ===================== BOUCLE FPS =====================
local SAMPLE_DT = 0.5
local frameCount, elapsed, hoverAcc = 0, 0, 0

G(RunService.RenderStepped, function(dt)
	frameCount += 1
	elapsed += dt
	if recording and #recData < 30000 then
		recData[#recData + 1] = dt
	end
	if dt > 0.05 and os.clock() - sessionStart > 3 then
		spikeCount += 1
		table.insert(spikes, { t = os.clock() - sessionStart, ms = dt * 1000 })
		if #spikes > 40 then table.remove(spikes, 1) end
	end

	if elapsed >= SAMPLE_DT then
		local fps = frameCount / elapsed
		local ms = (elapsed / frameCount) * 1000
		fpsLabel.Text = string.format("%d FPS", math.round(fps))
		msLabel.Text = string.format("%.1f ms", ms)
		local col = fpsColor(fps)
		statusDot.BackgroundColor3 = col
		fpsLabel.TextColor3 = col

		table.insert(history, fps)
		if #history > HIST_MAX then table.remove(history, 1) end

		if not S.compact then
			for i = 1, SPARK_N do
				local v = history[#history - SPARK_N + i]
				local b = sparkBars[i]
				if v then
					b.Size = UDim2.new(1 / SPARK_N, -1, math.clamp(v / GRAPH_MAX, 0.05, 1), 0)
					b.BackgroundColor3 = fpsColor(v)
				end
			end
		end
		if isPanelOpen and currentTab == "system" then
			updateGraph()
			updateSystemStats()
		elseif isPanelOpen and currentTab == "live" then
			updateLive()
		end
		if recording then
			LV.recLabel.Text = string.format("<b>Enregistrement en cours…</b>  %s · %d frames", fmtTime(os.clock() - recStart), #recData)
		end
		if S.alerts and fps < S.alertFps then lowFpsTicks += 1 else lowFpsTicks = 0 end
		local alerting = lowFpsTicks >= 4
		fpsStroke.Color = if alerting then C.Bad else Color3.new(1, 1, 1)
		fpsStroke.Transparency = if alerting then 0.1 else 0.9
		if lowFpsTicks == 4 then
			toast(string.format("Alerte : FPS sous %d", S.alertFps), C.Bad)
		end
		frameCount, elapsed = 0, 0
	end

	hoverAcc += dt
	if isPicking and isPanelOpen and UIS.MouseEnabled and not testing and hoverAcc >= 0.04 then
		hoverAcc = 0
		local mouse = UIS:GetMouseLocation()
		if not pointerOverUi(mouse) then
			local chain = chainAt(mouse)
			if chain then
				local keep = hoveredModel and table.find(chain, hoveredModel)
				hoverChain = chain
				hoverIdx = keep or 1
			else
				hoverChain, hoverIdx = nil, 1
			end
			local nextModel = if hoverChain then hoverChain[hoverIdx] else nil
			if nextModel ~= hoveredModel then applyHover() end
		end
	end
end)

