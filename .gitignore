local toastToken = 0
toast = function(text, color)
	toastToken += 1
	local t = toastToken
	toastLabel.Text = text
	toastLabel.TextColor3 = color or C.Text
	toastFrame.Visible = true
	task.delay(2.8, function()
		if t == toastToken then
			toastFrame.Visible = false
		end
	end)
end

