-- ===================== HELPERS =====================
local function isGlass(c)
	return c == C.Row or c == C.RowHover or c == C.Bg or c == C.Side or c == C.AccentBg
end

local function make(className, props, children)
	local inst = Instance.new(className)
	for k, v in pairs(props) do
		if k ~= "Parent" then
			inst[k] = v
		end
	end
	if inst:IsA("GuiObject") and props.BackgroundColor3 and props.BackgroundTransparency == nil
		and isGlass(props.BackgroundColor3) then
		inst.BackgroundTransparency = ROW_T
	end
	if children then
		for _, ch in ipairs(children) do
			ch.Parent = inst
		end
	end
	if props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end

local function corner(r)
	return make("UICorner", { CornerRadius = UDim.new(0, r) })
end

local function stroke(col, t, th)
	local isLine = col == C.Line
	return make("UIStroke", {
		Color = if isLine then Color3.new(1, 1, 1) else col,
		Transparency = if t >= 1 then 1 elseif isLine then 0.9 else t,
		Thickness = th or 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

local function lbl(props)
	local p = {
		BackgroundTransparency = 1,
		Font = FONT_REG,
		TextSize = 13,
		TextColor3 = C.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
	}
	for k, v in pairs(props) do
		p[k] = v
	end
	return make("TextLabel", p)
end

-- Aucune animation : les changements sont appliqués instantanément.
local function tw(inst, props)
	for k, v in pairs(props) do
		inst[k] = v
	end
end

local function rowBase() return C.Row end
local function rowHover() return C.RowHover end

local function hoverFx(btn, baseFn, hoverFn)
	btn.MouseEnter:Connect(function() btn.BackgroundColor3 = hoverFn() end)
	btn.MouseLeave:Connect(function() btn.BackgroundColor3 = baseFn() end)
end

-- Registre des éléments liés à la couleur d'accent
local accentCallbacks = {}
local function bindAccent(fn)
	table.insert(accentCallbacks, fn)
	fn()
end
local function setAccent(col)
	C.Accent = col
	C.AccentBg = col:Lerp(C.Bg, 0.82)
	for _, fn in ipairs(accentCallbacks) do
		fn()
	end
end

local function scoreColor(s)
	return if s >= 75 then C.Good elseif s >= 45 then C.Warn else C.Bad
end
local function scoreVerdict(s)
	return if s >= 75 then "OPTIMISÉ" elseif s >= 45 then "MOYEN" else "NON OPTIMISÉ"
end
local function colorFor(v, warn, bad)
	return if v > bad then C.Bad elseif v > warn then C.Warn else C.Text
end
local function fpsColor(fps)
	return if fps >= 50 then C.Good elseif fps >= 30 then C.Warn else C.Bad
end

