end

local function addToggle(row, initial, cb)
	local state = initial
	local btn = make("TextButton", {
		Size = UDim2.fromOffset(44, 24),
		Position = UDim2.new(1, -14, 0.5, 0),
		AnchorPoint = Vector2.new(1, 0.5),
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = C.Line,
		Parent = row,
	}, { corner(12) })
	local knob = make("Frame", {
		Size = UDim2.fromOffset(18, 18),
		Position = UDim2.new(0, 3, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundColor3 = C.Text,
		Parent = btn,
	}, { corner(9) })
	local function refresh()
		btn.BackgroundColor3 = if state then C.Accent else C.Line
		knob.Position = if state then UDim2.new(1, -21, 0.5, 0) else UDim2.new(0, 3, 0.5, 0)
	end
	bindAccent(refresh)
	btn.MouseButton1Click:Connect(function()
		state = not state
		refresh()
		cb(state)
	end)
end

local function addStepper(row, getText, onMinus, onPlus)
	local box = make("Frame", {
		Size = UDim2.fromOffset(136, 32),
		Position = UDim2.new(1, -14, 0.5, 0),
		AnchorPoint = Vector2.new(1, 0.5),
		BackgroundTransparency = 1,
		Parent = row,
	})
	local val = lbl({
		Size = UDim2.new(1, -64, 1, 0),
		Position = UDim2.fromOffset(32, 0),
		Font = FONT_SEMI,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Center,
		Text = getText(),
		Parent = box,
	})
	local function sb(text, x)
		local b = make("TextButton", {
			Size = UDim2.fromOffset(30, 30),
			Position = UDim2.new(x, 0, 0.5, 0),
			AnchorPoint = Vector2.new(x, 0.5),
			BackgroundColor3 = C.Bg,
			BackgroundTransparency = 0.3,
			AutoButtonColor = false,
			Font = FONT_BOLD,
			TextSize = 16,
			TextColor3 = C.Text,
			Text = text,
			Parent = box,
		}, { corner(8), stroke(C.Line, 0.5, 1) })
		hoverFx(b, function() return C.Bg end, rowHover)
		return b
	end
	sb("-", 0).MouseButton1Click:Connect(function() onMinus(); val.Text = getText() end)
	sb("+", 1).MouseButton1Click:Connect(function() onPlus(); val.Text = getText() end)
end

local function addSegmented(row, opts, get, set)
	local w = 56
	local box = make("Frame", {
		Size = UDim2.fromOffset(#opts * w + (#opts - 1) * 4, 30),
		Position = UDim2.new(1, -14, 0.5, 0),
		AnchorPoint = Vector2.new(1, 0.5),
		BackgroundTransparency = 1,
		Parent = row,
	}, { make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }) })
	local btns = {}
	local function refresh()
		for i, b in ipairs(btns) do
			local on = get() == i
			b.BackgroundColor3 = if on then C.AccentBg else C.Bg
			b.BackgroundTransparency = if on then 0.2 else 0.4
			b.TextColor3 = if on then C.Accent else C.Muted
		end
	end
	for i, name in ipairs(opts) do
		btns[i] = make("TextButton", {
			LayoutOrder = i,
			Size = UDim2.fromOffset(w, 30),
			AutoButtonColor = false,
			Font = FONT_SEMI,
			TextSize = 11,
			Text = name,
			BackgroundColor3 = C.Bg,
			Parent = box,
		}, { corner(8) })
		btns[i].MouseButton1Click:Connect(function()
			set(i)
			refresh()
		end)
	end
	bindAccent(refresh)
end

local function addActionRow(order, text, cb)
	local b = make("TextButton", {
		LayoutOrder = order,
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundColor3 = C.Row,
		AutoButtonColor = false,
		Font = FONT_SEMI,
		TextSize = 13,
		TextColor3 = C.Text,
		Text = text,
		Parent = pageSettings,
	}, { corner(10), stroke(C.Line, 0.5, 1) })
	hoverFx(b, rowBase, rowHover)
	b.MouseButton1Click:Connect(cb)
end

local function setPanelOpacity()
	panel.BackgroundTransparency = 1 - S.opacity
	fpsBar.BackgroundTransparency = 1 - S.opacity
end

local order = 0
local function nextOrder() order += 1 return order end

sectionTitle(nextOrder(), "Interface")
do
	local r = settingRow(nextOrder(), "Taille de l'interface", "Agrandit ou réduit tout l'outil", 136)
	addStepper(r,
		function() return string.format("%d%%", math.round(S.uiMul * 100)) end,
		function() S.uiMul = math.clamp(S.uiMul - 0.1, 0.6, 1.8); applyScale() end,
		function() S.uiMul = math.clamp(S.uiMul + 0.1, 0.6, 1.8); applyScale() end)

	r = settingRow(nextOrder(), "Opacité du fond", "Plus bas = plus transparent", 136)
	addStepper(r,
		function() return string.format("%d%%", math.round(S.opacity * 100)) end,
		function() S.opacity = math.clamp(S.opacity - 0.1, 0.2, 1); setPanelOpacity() end,
		function() S.opacity = math.clamp(S.opacity + 0.1, 0.2, 1); setPanelOpacity() end)

	r = settingRow(nextOrder(), "Couleur d'accent", "Personnalise les boutons et surbrillances", 170)
	local sw = make("Frame", {
		Size = UDim2.fromOffset(#PALETTE * 24 + (#PALETTE - 1) * 6, 24),
		Position = UDim2.new(1, -14, 0.5, 0),
		AnchorPoint = Vector2.new(1, 0.5),
		BackgroundTransparency = 1,
		Parent = r,
	}, { make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }) })
	local swBtns = {}
	for i, col in ipairs(PALETTE) do
		local b = make("TextButton", {
			LayoutOrder = i,
			Size = UDim2.fromOffset(24, 24),
			BackgroundColor3 = col,
			AutoButtonColor = false,
			Text = "",
			Parent = sw,
		}, { corner(12) })
		local st = stroke(C.Text, 1, 2)
		st.Parent = b
		swBtns[i] = { b = b, st = st, col = col }
		b.MouseButton1Click:Connect(function()
			setAccent(col)
			for _, o in ipairs(swBtns) do o.st.Transparency = if o.col == col then 0 else 1 end
		end)
	end
	swBtns[1].st.Transparency = 0

	r = settingRow(nextOrder(), "Barre FPS compacte", "Masque le temps de frame et le mini-graphique", 60)
	addToggle(r, S.compact, function(v) S.compact = v; applyCompact(); layoutPanel() end)
end

sectionTitle(nextOrder(), "Analyse")
do
	local r = settingRow(nextOrder(), "Sévérité des seuils", "Strict = plus d'avertissements, Souple = moins", 190)
	addSegmented(r, SEV_NAMES, function() return S.severity end, function(i)
		S.severity = i
		if selected and lastScan then analyze(selected) end
		toast("Sévérité : " .. SEV_NAMES[i], C.Accent)
	end)

	r = settingRow(nextOrder(), "Surligner au survol", "Contour pendant le ciblage 3D", 60)
	addToggle(r, S.hoverHL, function(v) S.hoverHL = v; if isPicking then applyHover() end end)

	r = settingRow(nextOrder(), "Surligner la sélection", "Contour blanc sur le modèle analysé", 60)
	addToggle(r, S.selHL, function(v) S.selHL = v; updateSelectionHL() end)

	r = settingRow(nextOrder(), "Ignorer les personnages", "Exclut les joueurs du ciblage et des scans", 60)
	addToggle(r, S.ignorePlayers, function(v) S.ignorePlayers = v end)
end

sectionTitle(nextOrder(), "Profil")
do
	local r = settingRow(nextOrder(), "Alerte de FPS bas", "Contour rouge de la barre sous le seuil (2 s)", 60)
	addToggle(r, S.alerts, function(v) S.alerts = v end)

	r = settingRow(nextOrder(), "Seuil d'alerte", "FPS en dessous duquel l'alerte se déclenche", 136)
	addStepper(r,
		function() return S.alertFps .. " FPS" end,
		function() S.alertFps = math.clamp(S.alertFps - 5, 10, 120) end,
		function() S.alertFps = math.clamp(S.alertFps + 5, 10, 120) end)

	local function qualityLevel()
		local ok, v = pcall(function() return settings().Rendering.QualityLevel.Value end)
		return if ok then v else 0
	end
	local function setQuality(n)
		n = math.clamp(n, 1, 21)
		local ok = pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel:FromValue(n) end)
		if not ok then toast("Qualité non modifiable ici.", C.Warn) end
	end
	r = settingRow(nextOrder(), "Qualité graphique (test)", "Change le niveau local pour comparer les FPS", 136)
	addStepper(r,
		function() local q = qualityLevel(); return if q == 0 then "Auto" else tostring(q) end,
		function() setQuality((if qualityLevel() == 0 then 10 else qualityLevel()) - 1) end,
		function() setQuality((if qualityLevel() == 0 then 10 else qualityLevel()) + 1) end)
end

