LV.spikeLabel = textCard(5)

local MEM_TAGS = Enum.DeveloperMemoryTag:GetEnumItems()

local function updateLive()
	local ok, v = pcall(function() return StatsService.HeartbeatTimeMs end)
	LV.hb.Text = if ok and v then string.format("%.1f ms", v) else "n/a"
	ok, v = pcall(function() return StatsService.PhysicsStepTimeMs end)
	LV.phys.Text = if ok and v then string.format("%.1f ms", v) else "n/a"
	ok, v = pcall(function() return StatsService.DataSendKbps end)
	LV.send.Text = if ok and v then string.format("%.1f KB/s", v) else "n/a"
	ok, v = pcall(function() return StatsService.DataReceiveKbps end)
	LV.recv.Text = if ok and v then string.format("%.1f KB/s", v) else "n/a"
	LV.spk.Text = tostring(spikeCount)
	LV.spk.TextColor3 = if spikeCount > 10 then C.Bad elseif spikeCount > 3 then C.Warn else C.Text
	LV.time.Text = fmtTime(os.clock() - sessionStart)

	local list = {}
	for _, tag in ipairs(MEM_TAGS) do
		local okT, mb = pcall(function() return StatsService:GetMemoryUsageMbForTag(tag) end)
		if okT and mb and mb > 0.05 then table.insert(list, { name = tag.Name, mb = mb }) end
	end
	table.sort(list, function(a, b) return a.mb > b.mb end)
	for i, r in ipairs(LV.memRows) do
		local e = list[i]
		r.row.Visible = e ~= nil
		if e then
			r.name.Text = e.name
			r.val.Text = string.format("%.1f MB", e.mb)
			r.fill.Size = UDim2.fromScale(math.clamp(e.mb / list[1].mb, 0.02, 1), 1)
		end
	end

	local lines = { '<font color="#' .. C.Muted:ToHex() .. '"><b>DERNIERS PICS DE FRAME (> 50 ms)</b></font>' }
	for i = #spikes, math.max(1, #spikes - 7), -1 do
		local sp = spikes[i]
		table.insert(lines, string.format('<b>%s</b>    <font color="#%s">%.0f ms</font>', fmtTime(sp.t),
			(if sp.ms > 100 then C.Bad else C.Warn):ToHex(), sp.ms))
	end
	if #spikes == 0 then table.insert(lines, "Aucun pic détecté depuis le début de la session.") end
	LV.spikeLabel.Text = table.concat(lines, "\n")
end

local function stopRecording()
	recording = false
	LV.rec.Text = "Enregistrer  (F8)"
	LV.rec.TextColor3 = C.Text
	local n = #recData
	if n < 30 then
		LV.recLabel.Text = "Enregistrement trop court pour produire un rapport."
		return
	end
	local sum, o33, o50 = 0, 0, 0
	for _, d in ipairs(recData) do
		sum += d
		if d > 0.0333 then o33 += 1 end
		if d > 0.05 then o50 += 1 end
	end
	local sorted = table.clone(recData)
	table.sort(sorted)
	local function pct(p) return sorted[math.clamp(math.ceil(n * p), 1, n)] * 1000 end
	local take = math.max(1, math.ceil(n * 0.01))
	local worstSum = 0
	for i = n - take + 1, n do worstSum += sorted[i] end
	local avgFps, low1 = n / sum, take / worstSum
	local grade, gcol
	if low1 >= 50 and o50 == 0 then
		grade, gcol = "FLUIDE", C.Good
	elseif low1 >= 30 then
		grade, gcol = "CORRECT", C.Warn
	else
		grade, gcol = "SACCADÉ", C.Bad
	end
	LV.recLabel.Text = string.format(
		'<font color="#%s"><b>Rapport : %s</b></font>   (%s · %d frames)\nFPS moyen <b>%.0f</b>   ·   1%% bas <b>%.0f</b>\nTemps de frame : p50 %.1f ms · p95 %.1f ms · p99 %.1f ms · pire %.1f ms\nFrames > 33 ms : %d (%.1f%%)   ·   > 50 ms : %d',
		gcol:ToHex(), grade, fmtTime(sum), n, avgFps, low1, pct(0.5), pct(0.95), pct(0.99), sorted[n] * 1000, o33, o33 / n * 100, o50)
end

local function toggleRecord()
	if recording then
		stopRecording()
		toast("Enregistrement terminé", C.Good)
	else
		recData = {}
		recStart = os.clock()
		recording = true
		LV.rec.Text = "Arrêter  (F8)"
		LV.rec.TextColor3 = C.Bad
		LV.recLabel.Text = "<b>Enregistrement en cours…</b>"
		toast("Enregistrement démarré (F8 pour arrêter)", C.Accent)
	end
end
LV.rec.MouseButton1Click:Connect(toggleRecord)
LV.clear.MouseButton1Click:Connect(function()
	spikes, spikeCount = {}, 0
	updateLive()
end)

-- ===================== HIGHLIGHTS / MARQUEURS =====================
local hoverHL = make("Highlight", {
	Name = "Hover",
	FillTransparency = 0.8,
	OutlineTransparency = 0,
	DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
	Enabled = false,
	Parent = hlFolder,
})
bindAccent(function()
	hoverHL.FillColor = C.Accent
	hoverHL.OutlineColor = C.Accent
end)
local selHL = make("Highlight", {
	Name = "Selected",
	FillTransparency = 1,
	OutlineColor = Color3.fromRGB(255, 255, 255),
	OutlineTransparency = 0.25,
	DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
	Enabled = false,
	Parent = hlFolder,
})

local function clearMarkers()
	markersFolder:ClearAllChildren()
	if activeRow and activeRow.Parent then
		activeRow.BackgroundColor3 = C.Row
	end
	activeRow = nil
end

local function showMarkers(list, color)
	for i, part in ipairs(list) do
		if i > MAX_MARKERS then break end
		if part and part.Parent then
			make("BoxHandleAdornment", {
				Adornee = part,
				Size = part.Size + Vector3.new(0.06, 0.06, 0.06),
				Color3 = color,
				Transparency = 0.55,
				AlwaysOnTop = true,
				ZIndex = 1,
				Parent = markersFolder,
			})
		end
	end
end

local function updateSelectionHL()
	local t = selected
	if S.selHL and t and t ~= Workspace and t.Parent and t:IsA("PVInstance") then
		selHL.Adornee = t
		selHL.Enabled = true
	else
		selHL.Adornee = nil
		selHL.Enabled = false
	end
end

-- ===================== MASQUAGE LOCAL (test d'impact) =====================
local function isFx(d)
	return d:IsA("ParticleEmitter") or d:IsA("Beam") or d:IsA("Trail") or d:IsA("Light")
		or d:IsA("Fire") or d:IsA("Smoke") or d:IsA("Sparkles")
end

local function applyHidden(target)
	if hiddenState or not target or target == Workspace then return end
	local st = { parts = {}, fx = {} }
	for _, d in ipairs(target:GetDescendants()) do
		if d:IsA("BasePart") then
			st.parts[d] = d.LocalTransparencyModifier
			d.LocalTransparencyModifier = 1
		elseif isFx(d) then
			st.fx[d] = d.Enabled
			d.Enabled = false
		end
	end
	hiddenState = { target = target, st = st }
end

local function restoreHidden()
	if not hiddenState then return end
	local st = hiddenState.st
	for p, v in pairs(st.parts) do
		if p.Parent then p.LocalTransparencyModifier = v end
	end
	for f, v in pairs(st.fx) do
		if f.Parent then f.Enabled = v end
	end
	hiddenState = nil
end

updateActions = function()
	local has = selected ~= nil and selected ~= Workspace
	B.test.TextColor3 = if has then C.Text else C.Muted
	B.hide.TextColor3 = if selected then C.Text else C.Muted
	B.hide.Text = if hiddenState then "Afficher" else "Masquer"
	B.report.TextColor3 = if lastScan then C.Text else C.Muted
	B.redo.TextColor3 = if selected then C.Text else C.Muted
	B.fixall.TextColor3 = if lastScan then C.Text else C.Muted
	B.undo.TextColor3 = if #undoStack > 0 then C.Text else C.Muted
end

-- ===================== SCAN / EVALUATION =====================
local function buildSkipSet()
	local skip = {}
	if S.ignorePlayers then
		for _, p in ipairs(Players:GetPlayers()) do
			local ch = p.Character
			if ch then
				skip[ch] = true
				for _, d in ipairs(ch:GetDescendants()) do skip[d] = true end
			end
		end
	end
	skip[Workspace.Terrain] = true
	return skip
end

local KIND_CACHE = {}
local function kindOf(d)
	local cn = d.ClassName
	local k = KIND_CACHE[cn]
	if k == nil then
		if d:IsA("BasePart") then k = "part"
		elseif d:IsA("Light") then k = "light"
		elseif d:IsA("ParticleEmitter") or d:IsA("Beam") or d:IsA("Trail") or d:IsA("Fire")
			or d:IsA("Smoke") or d:IsA("Sparkles") then k = "fx"
		elseif d:IsA("BaseScript") then k = "script"
		elseif d:IsA("Decal") or d:IsA("Texture") then k = "decal"
		elseif d:IsA("SurfaceGui") then k = "gui"
		elseif d:IsA("Constraint") or d:IsA("JointInstance") or d:IsA("WeldConstraint") then k = "joint"
		else k = false end
		KIND_CACHE[cn] = k
	end
	return k
end

local function scan(target, cancel, progress, yieldEvery, skip)
	local n = {
		parts = 0, meshes = 0, unions = 0, uniq = 0, precise = 0, rprecise = 0, shadows = 0,
		transp = 0, unanch = 0, touch = 0, lights = 0, lightSh = 0, fx = 0, scripts = 0,
		decals = 0, guis = 0, joints = 0,
	}
	local L = { unions = {}, precise = {}, rprecise = {}, shadows = {}, transp = {}, unanch = {}, touch = {}, lightSh = {}, fx = {} }
	skip = skip or buildSkipSet()
	local meshIds = {}
	local t0 = os.clock()
	local descendants = target:GetDescendants()
	local total = #descendants

	for i, d in ipairs(descendants) do
		if yieldEvery and i % yieldEvery == 0 then
			if progress then progress(i / total) end
			task.wait()
			if cancel and cancel() then return nil end
		end
		local kind = kindOf(d)
		if not kind or skip[d] then continue end

		if kind == "part" then
			n.parts += 1
			if d.CastShadow then
				n.shadows += 1
				table.insert(L.shadows, d)
			end
			if (d.Transparency > 0 and d.Transparency < 1) or d.Material == Enum.Material.Glass then
				n.transp += 1
				table.insert(L.transp, d)
			end
			if not d.Anchored then
				n.unanch += 1
				table.insert(L.unanch, d)
			elseif not d.CanCollide and d.CanTouch and d.CanQuery then
				n.touch += 1
				table.insert(L.touch, d)
			end
			if d:IsA("MeshPart") then
				n.meshes += 1
				if d.MeshId ~= "" then meshIds[d.MeshId] = true end
				if d.CanCollide and d.CollisionFidelity == Enum.CollisionFidelity.PreciseConvexDecomposition then
					n.precise += 1
					table.insert(L.precise, d)
				end
				if d.RenderFidelity == Enum.RenderFidelity.Precise then
					n.rprecise += 1
					table.insert(L.rprecise, d)
				end
			elseif d:IsA("UnionOperation") then
				n.unions += 1
				table.insert(L.unions, d)
				if d.CanCollide and d.CollisionFidelity == Enum.CollisionFidelity.PreciseConvexDecomposition then
					n.precise += 1
					table.insert(L.precise, d)
				end
			end
		elseif kind == "light" then
			if d.Enabled then
				n.lights += 1
				if d.Shadows then
					n.lightSh += 1
					local p = d.Parent
					if p and p:IsA("Attachment") then p = p.Parent end
					if p and p:IsA("BasePart") then table.insert(L.lightSh, p) end
				end
			end
		elseif kind == "fx" then
			if d.Enabled then
				n.fx += 1
				local p = d.Parent
				if p and p:IsA("Attachment") then p = p.Parent end
				if p and p:IsA("BasePart") then table.insert(L.fx, p) end
			end
		elseif kind == "script" then
			if d.Enabled then n.scripts += 1 end
		elseif kind == "decal" then
			n.decals += 1
		elseif kind == "gui" then
			n.guis += 1
		elseif kind == "joint" then
			n.joints += 1
		end
	end
	for _ in pairs(meshIds) do n.uniq += 1 end
	return { n = n, L = L, total = total, time = os.clock() - t0 }
end

local function evaluate(n, L, k)
	local score = 100
	local issues = {}
	local function flag(bad, penalty, text, tip, list)
		score -= penalty
		table.insert(issues, { text = text, tip = tip, color = if bad then C.Bad else C.Warn, list = list or {}, bad = bad })
	end

	if n.parts > 500 * k then
		flag(true, 30, string.format("Trop de pièces (%d)", n.parts), "Fusionnez les détails en MeshParts, supprimez les pièces invisibles.")
	elseif n.parts > 250 * k then
		flag(false, 15, string.format("Nombre de pièces élevé (%d)", n.parts), "Visez moins de 250 pièces par modèle.")
	elseif n.parts > 120 * k then
		score -= 5
	end

	if n.unions > 15 * k then
		flag(true, 20, string.format("%d Unions CSG", n.unions), "Convertissez-les en MeshPart (export/import Blender).", L.unions)
	elseif n.unions > 5 * k then
		flag(false, 10, string.format("%d Unions CSG détectées", n.unions), "Les unions sont plus lourdes que des meshs.", L.unions)
	elseif n.unions > 0 then
		score -= 3
	end

	if n.precise > 20 * k then
		flag(true, 20, string.format("%d collisions « Precise »", n.precise), "Passez CollisionFidelity en Hull, Box ou Default.", L.precise)
	elseif n.precise > 5 * k then
		flag(false, 10, string.format("%d collisions « Precise » coûteuses", n.precise), "Utilisez Hull ou Box quand c'est possible.", L.precise)
	elseif n.precise > 0 then
		score -= 4
	end

	if n.shadows > 250 * k then
		flag(true, 15, string.format("%d pièces avec CastShadow", n.shadows), "Désactivez CastShadow sur les petits détails.", L.shadows)
	elseif n.shadows > 100 * k then
		flag(false, 7, string.format("%d pièces projettent des ombres", n.shadows), "Désactivez CastShadow sur les détails.", L.shadows)
	end

	if n.unanch > 200 * k then
		flag(true, 12, string.format("%d pièces non ancrées", n.unanch), "Ancrez (Anchored) tout ce qui est statique : coût physique.", L.unanch)
	elseif n.unanch > 60 * k then
		flag(false, 6, string.format("%d pièces non ancrées", n.unanch), "Ancrez les pièces qui ne bougent pas.", L.unanch)
	end

	if n.touch > 150 * k then
		flag(false, 5, string.format("%d pièces décoratives avec Touch/Query", n.touch), "Désactivez CanTouch et CanQuery sur ces pièces.", L.touch)
	end

	if n.transp > 40 * k then
		flag(false, 10, string.format("%d pièces transparentes / Glass", n.transp), "La transparence coûte cher en rendu.", L.transp)
	elseif n.transp > 15 * k then
		score -= 4
	end

	if n.lightSh > 4 * k then
		flag(true, 15, string.format("%d lumières avec Shadows", n.lightSh), "Une seule lumière à ombres suffit souvent.", L.lightSh)
	elseif n.lightSh > 1 * k then
		flag(false, 7, string.format("%d lumières projettent des ombres", n.lightSh), "Désactivez Shadows sur les lumières secondaires.", L.lightSh)
	end

	if n.fx > 10 * k then
		flag(false, 10, string.format("%d effets actifs (particules, beams…)", n.fx), "Réduisez le Rate ou désactivez hors de vue.", L.fx)
	elseif n.fx > 4 * k then
		score -= 4
	end

	if n.rprecise > 25 * k then
		flag(false, 6, string.format("%d MeshParts en RenderFidelity Precise", n.rprecise), "Utilisez Automatic ou Performance.", L.rprecise)
	end

	if n.uniq > 80 * k then
		flag(false, 5, string.format("%d MeshIds différents", n.uniq), "Réutilisez les mêmes meshs pour réduire les draw calls.")
	end

	if n.guis > 10 * k then
		flag(false, 5, string.format("%d SurfaceGuis", n.guis), "Chaque SurfaceGui a un coût de rendu : limitez-les.")
	end

	if n.joints > 60 * k then
		flag(false, 4, string.format("%d joints / contraintes", n.joints), "Réduisez les welds et contraintes inutiles.")
	end

	if n.scripts > 8 * k then
		flag(false, 8, string.format("%d scripts actifs", n.scripts), "Regroupez la logique dans moins de scripts.")
	end

	if n.decals > 150 * k then
		flag(false, 4, string.format("%d Decals/Textures", n.decals), "Fusionnez les textures dans un atlas.")
	end

	local sorted = {}
	for _, it in ipairs(issues) do if it.bad then table.insert(sorted, it) end end
	for _, it in ipairs(issues) do if not it.bad then table.insert(sorted, it) end end
	return math.clamp(score, 0, 100), sorted
end

local function currentK(isWorld)
	return SEV[S.severity] * (if isWorld then 12 else 1)
end

-- ===================== CORRECTIFS LOCAUX =====================
-- Les correctifs ne modifient que votre client (annulables avec « Annuler »).
-- Reportez ensuite les changements dans Studio.
local function setProp(rec, inst, prop, val)
	if inst[prop] ~= val then
		table.insert(rec, { inst, prop, inst[prop] })
		inst[prop] = val
	end
end

local FIXES = {
	shadows = function(p, rec) setProp(rec, p, "CastShadow", false) end,
	touch = function(p, rec)
		setProp(rec, p, "CanTouch", false)
		setProp(rec, p, "CanQuery", false)
	end,
	precise = function(p, rec) setProp(rec, p, "CollisionFidelity", Enum.CollisionFidelity.Hull) end,
	rprecise = function(p, rec) setProp(rec, p, "RenderFidelity", Enum.RenderFidelity.Automatic) end,
	lightSh = function(p, rec)
		for _, d in ipairs(p:GetDescendants()) do
			if d:IsA("Light") then setProp(rec, d, "Shadows", false) end
		end
	end,
	fx = function(p, rec)
		for _, d in ipairs(p:GetDescendants()) do
			if d:IsA("ParticleEmitter") or d:IsA("Beam") or d:IsA("Trail") or d:IsA("Fire")
				or d:IsA("Smoke") or d:IsA("Sparkles") then
				setProp(rec, d, "Enabled", false)
			end
		end
	end,
}

local function applyFix(key, list)
	local fn = FIXES[key]
	if not fn then return 0 end
	local rec = {}
	for _, p in ipairs(list) do
		if p.Parent then fn(p, rec) end
	end
	if #rec > 0 then table.insert(undoStack, rec) end
	return #rec
end

local function reanalyzeAfterFix(prev, changed)
	if not selected then return end
	local target = selected
	task.spawn(function()
		analyze(target)
		if lastScan then
			toast(string.format("%d modifications · score %d → %d", changed, prev, lastScan.score),
				if lastScan.score >= prev then C.Good else C.Warn)
		end
	end)
end

B.fixall.MouseButton1Click:Connect(function()
	if testing then return end
	if not lastScan then
		toast("Analysez d'abord un modèle.", C.Warn)
		return
	end
	local prev, changed = lastScan.score, 0
	for _, it in ipairs(lastScan.issues) do
		if it.key and FIXES[it.key] then changed += applyFix(it.key, it.list) end
	end
	if changed == 0 then
		toast("Rien à corriger automatiquement.", C.Warn)
		return
	end
	reanalyzeAfterFix(prev, changed)
end)

B.undo.MouseButton1Click:Connect(function()
	if testing then return end
	local rec = table.remove(undoStack)
	if not rec then
		toast("Aucun correctif à annuler.", C.Warn)
		return
	end
	for i = #rec, 1, -1 do
		local inst, prop, old = rec[i][1], rec[i][2], rec[i][3]
		if inst.Parent then inst[prop] = old end
	end
	updateActions()
	toast(string.format("%d modifications annulées", #rec), C.Good)
	if selected then
		local target = selected
		task.spawn(analyze, target)
	end
end)

-- ===================== ISSUES UI =====================
local function clearIssues()
	clearMarkers()
	for _, ch in ipairs(U.issuesList:GetChildren()) do
		if not ch:IsA("UIListLayout") then ch:Destroy() end
	end
end

local function addInfoRow(text, color, order)
	local l = lbl({
		LayoutOrder = order,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = ROW_T,
		BackgroundColor3 = C.Row,
		TextWrapped = true,
		TextColor3 = color,
		TextSize = 12,
		Text = text,
		Parent = U.issuesList,
	})
	make("UICorner", { CornerRadius = UDim.new(0, 9), Parent = l })
	make("UIPadding", {
		PaddingTop = UDim.new(0, 12), PaddingBottom = UDim.new(0, 12),
		PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14),
		Parent = l,
	})
end

local function addIssueRow(order, item)
	local row = make("TextButton", {
		LayoutOrder = order,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = C.Row,
		AutoButtonColor = false,
		Text = "",
		Parent = U.issuesList,
	}, { corner(9), stroke(C.Line, 0.5, 1), make("UISizeConstraint", { MinSize = Vector2.new(0, 62) }) })
	make("Frame", {
		Size = UDim2.new(0, 3, 1, -18),
		Position = UDim2.fromOffset(8, 9),
		BackgroundColor3 = item.color,
		BorderSizePixel = 0,
		Parent = row,
	}, { corner(2) })
	local text = lbl({
		Size = UDim2.new(1, -112, 0, 0),
		Position = UDim2.fromOffset(22, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		RichText = true,
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextSize = 12,
		Text = string.format(
			'<font color="#%s"><b>%s</b></font>\n<font color="#%s" size="11">%s</font>',
			item.color:ToHex(), item.text, C.Muted:ToHex(), item.tip
		),
		Parent = row,
	})
	make("UIPadding", { PaddingTop = UDim.new(0, 12), PaddingBottom = UDim.new(0, 14), Parent = text })

	if #item.list > 0 then
		lbl({
			Size = UDim2.fromOffset(70, 12),
			Position = UDim2.new(1, -12, 0, 10),
			AnchorPoint = Vector2.new(1, 0),
			TextSize = 11,
			Font = FONT_SEMI,
			TextColor3 = C.Accent,
			TextXAlignment = Enum.TextXAlignment.Right,
			Text = "Voir " .. (if #item.list > MAX_MARKERS then MAX_MARKERS .. "+" else tostring(#item.list)),
			Parent = row,
		})
		if item.key and FIXES[item.key] then
			local fb = make("TextButton", {
				Size = UDim2.fromOffset(66, 22),
				Position = UDim2.new(1, -12, 1, -10),
				AnchorPoint = Vector2.new(1, 1),
				BackgroundColor3 = C.AccentBg,
				AutoButtonColor = false,
				Font = FONT_SEMI,
				TextSize = 11,
				TextColor3 = C.Accent,
				Text = "Corriger",
				Parent = row,
			}, { corner(6) })
			fb.MouseButton1Click:Connect(function()
				if testing then return end
				local prev = if lastScan then lastScan.score else 0
				local changed = applyFix(item.key, item.list)
				if changed == 0 then
					toast("Rien à modifier.", C.Warn)
					return
				end
				reanalyzeAfterFix(prev, changed)
			end)
		end
		row.MouseEnter:Connect(function()
			if activeRow ~= row then row.BackgroundColor3 = C.RowHover end
		end)
		row.MouseLeave:Connect(function()
			if activeRow ~= row then row.BackgroundColor3 = C.Row end
		end)
		row.MouseButton1Click:Connect(function()
			if activeRow == row then
				clearMarkers()
				return
			end
			clearMarkers()
			activeRow = row
			row.BackgroundColor3 = C.RowHover
			showMarkers(item.list, item.color)
		end)
	end
end

-- ===================== ANALYSE =====================
local function renderAnalysis(target, data)
	local n, L = data.n, data.L
	local isWorld = target == Workspace
	local k = currentK(isWorld)
	local score, issues = evaluate(n, L, k)
	for _, it in ipairs(issues) do
		for key, l in pairs(L) do
			if l == it.list then it.key = key end
		end
	end
	local col = scoreColor(score)

	V.parts.Text = tostring(n.parts)
	V.parts.TextColor3 = colorFor(n.parts, 250 * k, 500 * k)
	V.meshes.Text = tostring(n.meshes)
	V.unions.Text = tostring(n.unions)
	V.unions.TextColor3 = colorFor(n.unions, 5 * k, 15 * k)
	V.uniq.Text = tostring(n.uniq)
	V.uniq.TextColor3 = colorFor(n.uniq, 80 * k, 160 * k)
	V.shadows.Text = tostring(n.shadows)
	V.shadows.TextColor3 = colorFor(n.shadows, 100 * k, 250 * k)
	V.precise.Text = tostring(n.precise)
	V.precise.TextColor3 = colorFor(n.precise, 5 * k, 20 * k)
	V.unanch.Text = tostring(n.unanch)
	V.unanch.TextColor3 = colorFor(n.unanch, 60 * k, 200 * k)
	V.touch.Text = tostring(n.touch)
	V.touch.TextColor3 = colorFor(n.touch, 150 * k, 400 * k)
	V.transp.Text = tostring(n.transp)
	V.transp.TextColor3 = colorFor(n.transp, 15 * k, 40 * k)
	V.lights.Text = string.format("%d (%d)", n.lights, n.lightSh)
	V.lights.TextColor3 = colorFor(n.lightSh, 1 * k, 4 * k)
	V.fx.Text = tostring(n.fx)
	V.fx.TextColor3 = colorFor(n.fx, 4 * k, 10 * k)
	V.scripts.Text = tostring(n.scripts)
	V.guis.Text = tostring(n.guis)
	V.guis.TextColor3 = colorFor(n.guis, 10 * k, 30 * k)
	V.joints.Text = tostring(n.joints)
	V.joints.TextColor3 = colorFor(n.joints, 60 * k, 150 * k)
	V.decals.Text = tostring(n.decals)
	V.decals.TextColor3 = colorFor(n.decals, 150 * k, 400 * k)

	U.score.Text = tostring(score)
	U.score.TextColor3 = col
	U.verdict.Text = scoreVerdict(score)
	U.verdict.TextColor3 = col
	tw(U.scoreFill, { Size = UDim2.fromScale(score / 100, 1), BackgroundColor3 = col })
	U.info.Text = string.format("%d éléments · %.2fs%s%s", data.total, data.time,
		if isWorld then " · seuils ×12" else "", if S.severity ~= 2 then " · " .. SEV_NAMES[S.severity] else "")

	clearIssues()
	if #issues == 0 then
		addInfoRow("Modèle bien optimisé. Aucun problème majeur détecté.", C.Good, 1)
	else
		for i, item in ipairs(issues) do addIssueRow(i, item) end
	end

	lastScan = {
		name = target.Name,
		path = if isWorld then "Workspace" else target:GetFullName(),
		score = score,
		verdict = scoreVerdict(score),
		n = n,
		issues = issues,
	}
	updateActions()
end

analyze = function(target)
	analysisToken += 1
	local token = analysisToken
	if hiddenState and hiddenState.target ~= target and not testing then restoreHidden() end
	selected = target
	updateSelectionHL()

	local isWorld = target == Workspace
	U.name.Text = target.Name
	U.path.Text = if isWorld then "Workspace (scan global)" else target:GetFullName()
	U.info.Text = "Analyse en cours…"
	U.score.Text = "…"
	U.score.TextColor3 = C.Muted
	U.verdict.Text = "ANALYSE"
	U.verdict.TextColor3 = C.Muted
	tw(U.scoreFill, { Size = UDim2.fromScale(0, 1), BackgroundColor3 = C.Muted })
	X.impactCard.Visible = false
	clearIssues()
	addInfoRow("Analyse en cours…", C.Muted, 1)
	X.progFill.Size = UDim2.fromScale(0, 1)
	X.progTrack.Visible = true
	updateActions()

	local data = scan(target, function() return token ~= analysisToken end, function(p)
		X.progFill.Size = UDim2.fromScale(p, 1)
	end, 300)
	if not data or token ~= analysisToken then return end
	X.progTrack.Visible = false
	renderAnalysis(target, data)
end

-- ===================== CIBLAGE 3D =====================
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function modelChain(start)
	local chain = {}
	local cur = start
	while cur and cur ~= Workspace do
		if cur:IsA("Model") then table.insert(chain, cur) end
		cur = cur.Parent
	end
	return chain
end

local function baseFilter()
	local filter = {}
	if S.ignorePlayers then
		for _, p in ipairs(Players:GetPlayers()) do
			if p.Character then table.insert(filter, p.Character) end
		end
	elseif localPlayer.Character then
		table.insert(filter, localPlayer.Character)
	end
	return filter
end

local function chainAt(abs)
	local cam = Workspace.CurrentCamera
	if not cam then return nil end
	local ray = cam:ViewportPointToRay(abs.X, abs.Y)
	local filter = baseFilter()
	rayParams.FilterDescendantsInstances = filter
	for _ = 1, 6 do
		local res = Workspace:Raycast(ray.Origin, ray.Direction * 2000, rayParams)
		if not res or not res.Instance then return nil end
		local inst = res.Instance
		if inst:IsA("Terrain") then return nil end
		if inst.Transparency >= 1 then
			table.insert(filter, inst)
			rayParams.FilterDescendantsInstances = filter
		else
			local chain = modelChain(inst.Parent)
			if #chain == 0 then return nil end
			return chain
		end
	end
	return nil
end

local function pointerOverUi(abs)
	local function inside(f)
		local p, s = f.AbsolutePosition, f.AbsoluteSize
		return abs.X >= p.X and abs.X <= p.X + s.X and abs.Y >= p.Y and abs.Y <= p.Y + s.Y
	end
	if inside(fpsBar) then return true end
	return panel.Visible and inside(panel)
end

updateNavButtons = function()
	local can = (selChain ~= nil and not isPicking) or (isPicking and hoverChain ~= nil)
	B.up.TextColor3 = if can then C.Text else C.Muted
	B.down.TextColor3 = if can then C.Text else C.Muted
end

local function applyHover()
	if hoverChain and hoverChain[hoverIdx] then
		hoveredModel = hoverChain[hoverIdx]
		hoverHL.Adornee = hoveredModel
		hoverHL.Enabled = S.hoverHL
		X.banner.Text = string.format("Cible : %s  (niveau %d/%d)  ·  [Q] parent  [E] enfant", hoveredModel.Name, hoverIdx, #hoverChain)
	else
		hoveredModel = nil
		hoverHL.Adornee = nil
		hoverHL.Enabled = false
		X.banner.Text = "Survolez un modèle dans le monde et cliquez / touchez."
	end
	X.banner.TextColor3 = C.Accent
	updateNavButtons()
end

refreshPick = function()
	B.pick.BackgroundColor3 = if isPicking then C.Accent else C.Row
	B.pick.TextColor3 = if isPicking then C.Bg else C.Text
	B.pick.Text = if isPicking then "Ciblage…" else "Cibler"
end
bindAccent(refreshPick)

setPicking = function(active)
	isPicking = active
	refreshPick()
	if active then
		hoverChain, hoverIdx = nil, 1
		applyHover()
	else
		hoverHL.Enabled = false
		hoverHL.Adornee = nil
		hoveredModel, hoverChain = nil, nil
		if selected then
			X.banner.Text = "Analyse terminée. Parent/Enfant change le niveau, Cibler pour re-cibler."
		else
			X.banner.Text = "Cliquez sur « Cibler » puis sur un modèle du monde."
		end
		X.banner.TextColor3 = C.Muted
		updateNavButtons()
	end
end

local function pickAt(abs)
	if testing then return end
	local chain = chainAt(abs)
	if not chain then return end
	local idx = 1
	if hoveredModel then
		local f = table.find(chain, hoveredModel)
		if f then idx = f end
	end
	setPicking(false)
	selChain, selIdx = chain, idx
	analyze(chain[idx])
	updateNavButtons()
end

local function stepLevel(dir)
	if testing then return end
	if isPicking then
		if hoverChain then
			hoverIdx = math.clamp(hoverIdx + dir, 1, #hoverChain)
			applyHover()
		end
	elseif selChain then
		local newIdx = math.clamp(selIdx + dir, 1, #selChain)
		if newIdx ~= selIdx then
			selIdx = newIdx
			analyze(selChain[selIdx])
		end
	end
end

-- ===================== TEST D'IMPACT / RAPPORT =====================
local function measureFps(seconds)
	local t, frames = 0, 0
	while t < seconds do
		t += RunService.RenderStepped:Wait()
		frames += 1
	end
	return frames / t
end

local function runImpactTest()
	if testing then return end
	local target = selected
	if not target or target == Workspace or not target.Parent then
		toast("Sélectionnez d'abord un modèle précis.", C.Warn)
		return
	end
	restoreHidden()
	updateActions()
	testing = true
	X.impactCard.Visible = true
	X.impactLabel.Text = "<b>Mesure en cours…</b>\nGardez la caméra tournée vers le modèle (≈ 4 s)."
	local fpsOn, fpsOff
	local ok = pcall(function()
		task.wait(0.3)
		fpsOn = measureFps(1.5)
		applyHidden(target)
		task.wait(0.3)
		fpsOff = measureFps(1.5)
	end)
	restoreHidden()
	testing = false
	updateActions()

	if not ok or not fpsOn or not fpsOff then
		X.impactLabel.Text = "Mesure impossible (modèle supprimé ?)."
		return
	end
	local msOn, msOff = 1000 / fpsOn, 1000 / fpsOff
	local cost = msOn - msOff
	local text
	if cost >= 1 then
		text = string.format('<font color="#%s"><b>Coût de rendu ≈ %.1f ms / frame</b></font>\n%.0f FPS visible → %.0f FPS masqué (+%.0f FPS).',
			C.Bad:ToHex(), cost, fpsOn, fpsOff, fpsOff - fpsOn)
	elseif cost >= 0.3 then
		text = string.format('<font color="#%s"><b>Coût de rendu ≈ %.1f ms / frame</b></font>\n%.0f FPS visible → %.0f FPS masqué.',
			C.Warn:ToHex(), cost, fpsOn, fpsOff)
	else
		text = string.format('<font color="#%s"><b>Impact négligeable</b></font>\n%.0f FPS → %.0f FPS. Si vous attendiez plus : regardez le modèle de face, ou vos FPS sont plafonnés.',
			C.Good:ToHex(), fpsOn, fpsOff)
	end
	X.impactLabel.Text = text
	toast(string.format("Impact mesuré : %.1f ms / frame", math.max(cost, 0)), if cost >= 1 then C.Bad elseif cost >= 0.3 then C.Warn else C.Good)
end

local function buildReport()
	if not lastScan then return "Aucune analyse disponible." end
	local d, n = lastScan, lastScan.n
	local lines = {
		"=== RAPPORT D'OPTIMISATION ===",
		"Modèle : " .. d.name,
		"Chemin : " .. d.path,
		string.format("Score  : %d/100 (%s)", d.score, d.verdict),
		"",
		string.format("Pièces: %d | MeshParts: %d (MeshIds uniques: %d) | Unions: %d", n.parts, n.meshes, n.uniq, n.unions),
		string.format("CastShadow: %d | Col. précises: %d | Non-ancrées: %d | Touch/Query inutiles: %d", n.shadows, n.precise, n.unanch, n.touch),
		string.format("Transparentes: %d | Lumières: %d (ombres: %d) | FX: %d", n.transp, n.lights, n.lightSh, n.fx),
		string.format("Scripts: %d | SurfaceGuis: %d | Joints: %d | Decals: %d", n.scripts, n.guis, n.joints, n.decals),
		"",
		"Problèmes :",
	}
	if #d.issues == 0 then
		table.insert(lines, "  Aucun problème majeur.")
	else
		for _, it in ipairs(d.issues) do
			table.insert(lines, string.format("  - [%s] %s -> %s", if it.bad then "CRITIQUE" else "ATTENTION", it.text, it.tip))
		end
	end
	return table.concat(lines, "\n")
end

-- ===================== CLASSEMENT =====================
local function renderRanking()
	for _, ch in ipairs(R.list:GetChildren()) do
		if not ch:IsA("UIListLayout") then ch:Destroy() end
	end
	local arr = {}
	local q = string.lower(R.search.Text)
	for _, e in ipairs(rankResults) do
		if q == "" or string.find(string.lower(e.model:GetFullName()), q, 1, true) then
			table.insert(arr, e)
		end
	end
	if rankSort == "score" then
		table.sort(arr, function(a, b)
			if a.score ~= b.score then return a.score < b.score end
			return a.parts > b.parts
		end)
	else
		table.sort(arr, function(a, b) return a.parts > b.parts end)
	end
	for i = 1, math.min(25, #arr) do
		local e = arr[i]
		local row = make("TextButton", {
			LayoutOrder = i,
			Size = UDim2.new(1, 0, 0, 58),
			BackgroundColor3 = C.Row,
			AutoButtonColor = false,
			Text = "",
			Parent = R.list,
		}, { corner(9), stroke(C.Line, 0.5, 1) })
		hoverFx(row, rowBase, rowHover)
		lbl({
			Size = UDim2.fromOffset(30, 20),
			Position = UDim2.new(0, 12, 0.5, 0),
			AnchorPoint = Vector2.new(0, 0.5),
			Font = FONT_BOLD,
			TextSize = 12,
			TextColor3 = C.Muted,
			Text = "#" .. i,
			Parent = row,
		})
		lbl({
			Size = UDim2.new(1, -190, 0, 20),
			Position = UDim2.fromOffset(46, 10),
			Font = FONT_SEMI,
			TextSize = 13,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Text = e.model.Name,
			Parent = row,
		})
		lbl({
			Size = UDim2.new(1, -190, 0, 16),
			Position = UDim2.fromOffset(46, 32),
			TextSize = 10,
			TextColor3 = C.Muted,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Text = e.model:GetFullName(),
			Parent = row,
		})
		lbl({
			Size = UDim2.fromOffset(80, 16),
			Position = UDim2.new(1, -76, 0.5, 0),
			AnchorPoint = Vector2.new(1, 0.5),
			TextSize = 11,
			TextColor3 = C.Muted,
			TextXAlignment = Enum.TextXAlignment.Right,
			Text = e.parts .. " pièces",
			Parent = row,
		})
		local col = scoreColor(e.score)
		local badge = make("Frame", {
			Size = UDim2.fromOffset(48, 28),
			Position = UDim2.new(1, -12, 0.5, 0),
			AnchorPoint = Vector2.new(1, 0.5),
			BackgroundColor3 = col,
			BackgroundTransparency = 0.82,
			Parent = row,
		}, { corner(7) })
		lbl({
			Size = UDim2.fromScale(1, 1),
			Font = FONT_BOLD,
			TextSize = 14,
			TextColor3 = col,
			TextXAlignment = Enum.TextXAlignment.Center,
			Text = tostring(e.score),
			Parent = badge,
		})
		row.MouseButton1Click:Connect(function()
			if testing or not e.model.Parent then return end
			setPicking(false)
			selChain, selIdx = modelChain(e.model), 1
			setTab("model")
			analyze(e.model)
			updateNavButtons()
		end)
	end
end

local function runRankScan()
	if rankScanning then
		rankToken += 1
		return
	end
	rankScanning = true
	rankToken += 1
	local token = rankToken
	rankResults = {}
	renderRanking()
	R.status.Text = "Recherche des modèles…"
	R.status.TextColor3 = C.Muted
	R.track.Visible = true
	R.fill.Size = UDim2.fromScale(0, 1)
	R.scan.Text = "Arrêter"

	local t0 = os.clock()
	local skip = buildSkipSet()
	local candidates = {}
	local all = Workspace:GetDescendants()
	for i, m in ipairs(all) do
		if i % 4000 == 0 then
			task.wait()
			if token ~= rankToken then break end
		end
		if m:IsA("Model") and not skip[m] and m:FindFirstChildWhichIsA("BasePart") then
			table.insert(candidates, m)
			if #candidates >= 800 then break end
		end
	end

	local cost = 0
	if token == rankToken then
		for i, m in ipairs(candidates) do
			if m.Parent then
				local data = scan(m, nil, nil, nil, skip)
				if data then
					if data.n.parts >= 10 then
						local score = evaluate(data.n, data.L, currentK(false))
						table.insert(rankResults, { model = m, parts = data.n.parts, score = score })
					end
					cost += data.total
				end
			end
			if cost > 6000 then
				cost = 0
				R.fill.Size = UDim2.fromScale(i / #candidates, 1)
				R.status.Text = string.format("Analyse… %d / %d modèles", i, #candidates)
				task.wait()
				if token ~= rankToken then break end
			end
		end
	end

	R.track.Visible = false
	R.scan.Text = "Scanner la map"
	if token == rankToken then
		renderRanking()
		R.status.Text = string.format("%d modèles analysés en %.1fs · cliquez sur un modèle pour le détailler.", #rankResults, os.clock() - t0)
		R.status.TextColor3 = C.Text
	else
		R.status.Text = "Scan interrompu."
	end
	rankScanning = false
end

