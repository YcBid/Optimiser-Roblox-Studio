	Good = Color3.fromRGB(80, 205, 125),
	Warn = Color3.fromRGB(240, 175, 65),
	Bad = Color3.fromRGB(235, 90, 90),
	Accent = Color3.fromRGB(105, 155, 235),
	AccentBg = Color3.fromRGB(24, 34, 52),
}
