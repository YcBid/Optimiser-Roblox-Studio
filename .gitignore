-- Onglets (texte seul)
local TAB_DEFS = {
	{ id = "model", name = "Analyse", title = "Analyse du modèle", sub = "Ciblez un modèle pour mesurer son coût" },
	{ id = "rank", name = "Top", title = "Classement des modèles", sub = "Les modèles les plus lourds de la map" },
	{ id = "system", name = "Système", title = "Performances système", sub = "FPS, mémoire, réseau, physique" },
	{ id = "live", name = "Profil", title = "Profileur en direct", sub = "Mémoire, pics de frame, enregistrement" },
	{ id = "settings", name = "Réglages", title = "Réglages", sub = "Interface et seuils d'analyse" },
}
local tabs = {}
for i, def in ipairs(TAB_DEFS) do
	local btn = make("TextButton", {
		LayoutOrder = i,
		Size = UDim2.fromOffset(72, 38),
		BackgroundColor3 = C.AccentBg,
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Font = FONT_SEMI,
		TextSize = 12,
		Text = def.name,
		Parent = sideList,
	}, { corner(9) })
	local ind = make("Frame", {
		Size = UDim2.fromOffset(3, 18),
		Position = UDim2.new(0, -6, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		BorderSizePixel = 0,
		Parent = btn,
	}, { corner(2) })
	tabs[def.id] = { btn = btn, ind = ind }
	btn.MouseButton1Click:Connect(function() setTab(def.id) end)
	btn.MouseEnter:Connect(function()
		if currentTab ~= def.id then btn.BackgroundTransparency = 0.8 end
	end)
	btn.MouseLeave:Connect(function()
		if currentTab ~= def.id then btn.BackgroundTransparency = 1 end
	end)
end

local function refreshTabs()
	for id, t in pairs(tabs) do
		local active = id == currentTab
		t.btn.BackgroundColor3 = C.AccentBg
		t.btn.BackgroundTransparency = if active then 0.3 else 1
		t.ind.BackgroundColor3 = C.Accent
		t.ind.Visible = active
		t.btn.TextColor3 = if active then C.Accent else C.Muted
	end
	logo.TextColor3 = C.Accent
end
bindAccent(refreshTabs)

-- ===================== PAGE ANALYSE : UI =====================
local pageModel = pages.model

local function newGrid(parent, order, cols, rows, cellH)
	local gap = 8
	return make("Frame", {
		LayoutOrder = order,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = parent,
	}, {
		make("UIGridLayout", {
			CellSize = UDim2.new(1 / cols, -math.ceil(gap * (cols - 1) / cols) - 1, 0, cellH),
			CellPadding = UDim2.fromOffset(gap, gap),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
end

local function tileCell(grid, order, title)
	local cell = make("Frame", { LayoutOrder = order, BackgroundColor3 = C.Row, ClipsDescendants = true, Parent = grid }, { corner(9), stroke(C.Line, 0.5, 1) })
	local val = lbl({
		Size = UDim2.new(1, -20, 0, 26),
		Position = UDim2.fromOffset(12, 7),
		Font = FONT_BOLD,
		TextSize = 18,
		Text = "-",
		Parent = cell,
	})
	lbl({
		Size = UDim2.new(1, -20, 0, 14),
		Position = UDim2.fromOffset(12, 35),
		TextSize = 10,
		TextColor3 = C.Muted,
		Text = title,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = cell,
	})
	return val
end

