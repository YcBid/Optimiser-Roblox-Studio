--!nonstrict
-- PerfMonitor v4.1 — FPS + analyseur + profileur + correctifs
-- Interface : noir transparent, sans emoji, sans animation.
-- Placer dans un LocalScript, enfant d'un ScreenGui (StarterGui > ScreenGui).
-- Raccourcis : F6 ouvrir/fermer | F7 ré-analyser | F8 enregistrer | Q parent | E enfant

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
